{
  "name": "vesta",
  "productName": "Vesta",
  "version": "0.1.0-beta.1",
  "description": "Local-first desktop task organizer",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "license": "AGPL-3.0-only",
  "author": "Leandro Gonçalves",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "build": "electron-vite build",
    "package:beta": "node scripts/package-beta.ts --all",
    "package:mac": "node scripts/package-beta.ts --mac",
    "package:linux": "node scripts/package-beta.ts --linux",
    "package:win": "node scripts/package-beta.ts --win",
    "test:package": "vitest run -c vitest.package.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/marcellus": "5.3.0",
    "@milkdown/kit": "7.22.2",
    "@milkdown/plugin-prism": "7.22.2",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.16",
    "electron-log": "5.4.4",
    "gemoji": "8.1.0",
    "i18next": "26.4.2",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-util-chunked": "2.0.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-resolve-all": "2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "refractor": "5.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "micromark-util-types": "2.0.3",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
