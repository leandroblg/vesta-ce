.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ─────────────────────── Build output / Electron ────────────────────────
dist/
dist-electron/
out/
release/
