# Personal / machine-local:
.claude/settings.local.json
.claude/*.local.*
.claude/skills
CLAUDE.local.md

# ──────────────────────────────── Spec Kit ──────────────────────────────
# Machine-local state is ignored via .specify/.gitignore.
.specify
specs
